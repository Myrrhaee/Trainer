# Use only in an isolated migration/preflight job. Never attach this file to app runtime.
APP_ENV=staging
APP_RELEASE=replace-with-immutable-commit-hash
AUTH_PUBLIC_ORIGIN=https://staging.example.com

DATABASE_APP_URL=postgresql://app_login:replace-me@app-db.example.com/app?sslmode=verify-full
DATABASE_AUTH_URL=postgresql://auth_login:replace-me@auth-db.example.com/app?sslmode=verify-full
DATABASE_HEALTH_URL=postgresql://health_login:replace-me@health-db.example.com/app?sslmode=verify-full
# Required only when NOTIFICATION_DELIVERY_MODE is not disabled.
# DATABASE_WORKER_URL=postgresql://worker_login:replace-me@worker-db.example.com/app?sslmode=verify-full
# One operations login may hold both group roles; it must never be a runtime identity.
DATABASE_OPERATOR_URL=postgresql://operations_login:replace-me@operator-db.example.com/app?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://operations_login:replace-me@operator-db.example.com/app?sslmode=verify-full

# Pseudonymous operator identifier used in audit metadata, never an email address.
ALPHA_OPERATOR_REF=replace-with-operator-reference

# These values allow preflight to validate the complete deployment profile.
AUTH_OTP_PEPPER=replace-with-random-secret-at-least-32-bytes
AUTH_FLOW_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AUTH_DEV_OTP_DISCLOSURE=false
AUTH_EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=re_replace_with_provider_secret
AUTH_EMAIL_FROM=AI Strength Coach <login@example.com>

NEXT_PUBLIC_DEMO_MODE=false
ENABLE_LEGACY_SUPABASE_ONBOARDING=false
NEXT_PUBLIC_ENABLE_LEGACY_SUPABASE_ROSTER=false
NEXT_PUBLIC_ENABLE_LEGACY_SUPABASE_CLIENT_HOME=false
NOTIFICATION_DELIVERY_MODE=disabled

# Inert public constructor values for the eager legacy client import. These are not credentials.
NEXT_PUBLIC_SUPABASE_URL=https://legacy-supabase-disabled.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-supabase-disabled-public-anon-key
